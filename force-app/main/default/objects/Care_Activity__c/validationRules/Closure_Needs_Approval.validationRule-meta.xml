<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closure_Needs_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.CareLoop_Bypass_Validation) &amp;&amp;
AND(OR(ISNEW(), ISCHANGED(Status__c)), OR(ISPICKVAL(Status__c, "Missed"), ISPICKVAL(Status__c, "Cancelled")),
 NOT(ISPICKVAL(Approval_Status__c, "Approved")))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Marking an activity Missed or Cancelled needs supervisor approval. Use Submit for Approval.</errorMessage>
</ValidationRule>
