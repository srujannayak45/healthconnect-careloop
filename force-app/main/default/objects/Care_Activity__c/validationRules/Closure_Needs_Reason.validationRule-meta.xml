<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closure_Needs_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.CareLoop_Bypass_Validation) &amp;&amp;
AND(OR(ISPICKVAL(Status__c, "Missed"), ISPICKVAL(Status__c, "Cancelled")), ISBLANK(TEXT(Closure_Reason__c)))</errorConditionFormula>
    <errorDisplayField>Closure_Reason__c</errorDisplayField>
    <errorMessage>Select a closure reason.</errorMessage>
</ValidationRule>
