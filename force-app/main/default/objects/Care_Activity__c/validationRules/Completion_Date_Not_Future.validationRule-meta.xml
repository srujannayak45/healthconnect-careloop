<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.CareLoop_Bypass_Validation) &amp;&amp;
Completed_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage>Completed date cannot be in the future.</errorMessage>
</ValidationRule>
