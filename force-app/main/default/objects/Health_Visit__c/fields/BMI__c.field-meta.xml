<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BMI__c</fullName>
    <formula>IF(AND(NOT(ISBLANK(Weight_Kg__c)), NOT(ISBLANK(Height_Cm__c)), Height_Cm__c &gt; 0), Weight_Kg__c / ((Height_Cm__c / 100) * (Height_Cm__c / 100)), NULL)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>BMI</label>
    <precision>4</precision>
    <scale>1</scale>
    <type>Number</type>
</CustomField>
