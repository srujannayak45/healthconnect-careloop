<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unsuccessful_Visit_Has_No_Vitals</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.CareLoop_Bypass_Validation) &amp;&amp;
AND(NOT(ISPICKVAL(Visit_Outcome__c, "Completed")),
 OR(NOT(ISBLANK(BP_Systolic__c)), NOT(ISBLANK(SpO2__c)), NOT(ISBLANK(Temperature__c))))</errorConditionFormula>
    <errorDisplayField>Visit_Outcome__c</errorDisplayField>
    <errorMessage>Vitals can only be recorded when the visit outcome is Completed.</errorMessage>
</ValidationRule>
