<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Birthdate_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.CareLoop_Bypass_Validation) &amp;&amp;
Birthdate &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Birthdate</errorDisplayField>
    <errorMessage>Birthdate cannot be in the future.</errorMessage>
</ValidationRule>
