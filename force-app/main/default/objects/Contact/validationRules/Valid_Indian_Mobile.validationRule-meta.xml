<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Indian_Mobile</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.CareLoop_Bypass_Validation) &amp;&amp;
AND(NOT(ISBLANK(MobilePhone)), NOT(REGEX(MobilePhone, "^([+]91)?[6-9][0-9]{9}$")))</errorConditionFormula>
    <errorDisplayField>MobilePhone</errorDisplayField>
    <errorMessage>Enter a 10-digit Indian mobile number, optionally starting with +91.</errorMessage>
</ValidationRule>
